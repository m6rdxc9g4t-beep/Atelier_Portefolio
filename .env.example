# Port du serveur (API + site en production)
PORT=8787

# Construction seulement (lue par Vite) : adresse de la démo publique de DataMind, bouton « Essayer la démo ».
# Vide = pas de bouton (mention à la place). Sur le VPS : https://demo-datamind.<domaine> (Atelier_Deploy).
# VITE_DATAMIND_DEMO_URL=

# Facultatif : où enregistrer les messages du formulaire de contact (JSON Lines).
# MESSAGES_FILE=/var/data/portfolio/messages.jsonl

# Facultatif : le site est servi derrière un relais Netlify (réécriture 200 signée, voir Atelier_Deploy/netlify/portfolio).
# Même valeur que la variable PORTFOLIO_PROXY_SECRET du site Netlify : sert à reconnaître l'adresse réelle des visiteurs.
# NETLIFY_PROXY_SECRET=
