# Port du serveur (API + site en production)
PORT=8787

# Facultatif : active l'agent IA de la page DataMind (proxy vers l'API Claude).
# Sans clé, la page fonctionne (exploration CSV, graphiques) et l'agent est signalé hors ligne.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Facultatif : où enregistrer les messages du formulaire de contact (JSON Lines).
# MESSAGES_FILE=/var/data/portfolio/messages.jsonl
